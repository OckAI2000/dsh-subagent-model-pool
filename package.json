{
  "name": "dsh-subagent-model-pool",
  "version": "0.1.1",
  "description": "Independent DSH plugin: assign new subagents from a plugin-owned model pool using round-robin.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "dist",
    "src",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": true
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "npx -y -p typescript@7.0.2 tsc -p tsconfig.build.json",
    "typecheck": "npx -y -p typescript@7.0.2 tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OckAI2000/dsh-subagent-model-pool.git"
  },
  "homepage": "https://github.com/OckAI2000/dsh-subagent-model-pool#readme",
  "bugs": {
    "url": "https://github.com/OckAI2000/dsh-subagent-model-pool/issues"
  }
}
